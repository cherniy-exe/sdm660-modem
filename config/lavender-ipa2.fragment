# Kernel options required for the SDM660 IPA v2.6 modem data path.
# Extracted from the working device-config used on xiaomi-lavender (kernel 7.2.15).
CONFIG_NET=y
CONFIG_NET_IP_TUNNEL=m
CONFIG_QRTR=m
CONFIG_QRTR_SMD=m
CONFIG_QRTR_TUN=m
CONFIG_RMNET=m
CONFIG_QCOM_IPA2_LITE=m
CONFIG_QCOM_Q6V5_MSS=m
CONFIG_RPMSG=y
CONFIG_RPMSG_QCOM_GLINK=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_QCOM_SMEM=y
CONFIG_MSM_FIRMWARE_LOADER=y
CONFIG_ATH10K_SNOC=m
